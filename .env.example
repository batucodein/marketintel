# App
APP_NAME=MarketIntel
APP_ENV=development
LOG_LEVEL=INFO
PORT=8000
CORS_ORIGINS=http://localhost:3000

# Database (required)
DATABASE_URL=postgres://marketintel:marketintel@localhost:5433/marketintel?sslmode=disable

# Redis
REDIS_URL=redis://localhost:6379/0

# Auth
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# AI — at least one provider required
# Azure OpenAI
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_MINI_MODEL=gpt-5.4-mini
AZURE_OPENAI_NANO_MODEL=gpt-5.4-nano

# Anthropic Claude
ANTHROPIC_API_KEY=
CLAUDE_SONNET_MODEL=claude-sonnet-4-6
CLAUDE_HAIKU_MODEL=claude-haiku-4-5-20251001
CLAUDE_OPUS_MODEL=claude-opus-4-6

# Google Gemini
GOOGLE_AI_API_KEY=
GEMINI_PRO_MODEL=gemini-2.5-pro
GEMINI_FLASH_MODEL=gemini-2.5-flash
GEMINI_FLASH_LITE_MODEL=gemini-2.5-flash-lite

# Data sources
GOOGLE_PLACES_API_KEY=
COMTRADE_API_KEY=

# Tendata (optional — Excel import available as alternative)
TENDATA_API_KEY=
TENDATA_API_SECRET=
TENDATA_BASE_URL=https://open-api.tendata.cn

# REST Countries
REST_COUNTRIES_BASE_URL=https://restcountries.com/v3.1
